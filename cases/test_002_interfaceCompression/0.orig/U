FoamFile
{
    format ascii;
    class volVectorField;
    location "0";
    object U;
}

dimensions [0 1 -1 0 0 0 0];

internalField uniform (0 0 0);

boundaryField
{
    inlet_oil
    {
        type zeroGradient;
    }

    inlet_water
    {
        type zeroGradient;
    }

    outlet
    {
        type pressureInletOutletVelocity;
        value uniform (0 0 0);
    }

    flow_channel
    {
        type noSlip;
    }
}