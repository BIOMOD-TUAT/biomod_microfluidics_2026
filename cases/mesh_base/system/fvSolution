solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-07;
        relTol          0.05;
    }
    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }
    pcorr
    {
        $p_rgh;
        tolerance       1e-05;
        relTol          0;
    }
    pcorrFinal
    {
        $pcorr;
        relTol          0;
    }
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0;
    }
    alpha.water
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0;
        cAlpha          1;
        nAlphaCorr      1;
        nAlphaSubCycles 1;
    }
}

PIMPLE
{
    momentumPredictor no;
    nOuterCorrectors 1;
    nCorrectors      3;
    nNonOrthogonalCorrectors 1; // ← 0 から 1 または 2 に変更を推奨
}