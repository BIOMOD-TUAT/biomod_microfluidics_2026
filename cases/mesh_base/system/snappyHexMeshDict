FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

mergeTolerance  1e-6;

geometry
{
    flow_channel.stl
    {
        type triSurfaceMesh;
        name flow_channel;
    }

    // 中央の交差部を細分化する領域
    // 単位は m
    junctionBox
    {
        type searchableBox;

        min (-0.002 -0.0005 -0.00005);
        max ( 0.005    0.0005  0.00017);
    }
}

castellatedMeshControls
{
    maxLocalCells 100000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;

    nCellsBetweenLevels 3;

    // 特徴エッジはLevel 2まで。
    // 流路全体でLevel 3に細分化されるのを避ける。
    features
    (
        {
            file "flow_channel.eMesh";
            level 2;
        }
    );

    // 流路表面は全体でLevel 2
    refinementSurfaces
    {
        flow_channel
        {
            level (2 2);
        }
    }

    // 中央交差部だけLevel 3へ細分化
    refinementRegions
    {
        junctionBox
        {
            mode inside;
            levels
            (
                (1e15 5)
            );
        }
    }

    resolveFeatureAngle 30;

    allowFreeStandingZoneFaces true;

    // 流体領域内の点。現在の指定を維持する。
    locationInMesh (-0.0005 0 0.000075);
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;

    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls {}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-30;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.02;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}