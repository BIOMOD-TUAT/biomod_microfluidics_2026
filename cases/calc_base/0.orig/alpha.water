FoamFile { format ascii; class volScalarField; location "0"; object alpha.water; }
dimensions [0 0 0 0 0 0 0];
internalField uniform 0; // 初期状態は油で満たす
boundaryField {
    inlet_water { type fixedValue; value uniform 1; }
    inlet_oil1  { type fixedValue; value uniform 0; }
    inlet_oil2  { type fixedValue; value uniform 0; }
    outlet      { type zeroGradient; }
    flow_channel { // ここが壁面
        type constantAlphaContactAngle;
        theta0 110; // 110度で水を弾く（PDMSの疎水性）
        limit gradient;
        value uniform 0;
    }
}