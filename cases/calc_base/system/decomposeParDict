FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 学内サーバーの物理コア数に合わせて48分割に設定
numberOfSubdomains  48;

// 十字流路のようにメッシュ密度に偏りがある場合に負荷を均等にする手法
method              scotch;